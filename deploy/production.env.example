# Copy to .env.production. This example contains no working credentials.
ADMIN_PASSWORD=
APP_ORIGIN=https://orders.example.com
DATABASE_PATH=/app/data/restaurant.sqlite
MENU_UPLOAD_DIR=/app/data/uploads
# Turn ordering on after the owner verifies the live menu and tests a pickup.
ORDERING_ENABLED=false
DELIVERY_ENABLED=false
DELIVERY_FEE_PAISE=
# Imports missing source-menu IDs on startup; existing staff edits are preserved.
IMPORT_SOURCE_MENU=true
