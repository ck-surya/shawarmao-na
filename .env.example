# Required for staff login. Generate a long random value; never commit it.
ADMIN_PASSWORD=
# Local SQLite adapter only. Use a persistent disk for hosted deployment.
DATABASE_PATH=./data/restaurant.sqlite
# Photos default to an uploads/ directory alongside DATABASE_PATH.
# Optional override; use persistent storage and back it up with the database.
# MENU_UPLOAD_DIR=./data/uploads
# Enable to accept pickup orders. Delivery is configured separately below.
ORDERING_ENABLED=false
DELIVERY_ENABLED=false
DELIVERY_FEE_PAISE=
# Optional idempotent import of the bundled menu when opening the database.
IMPORT_SOURCE_MENU=false

# Netlify/Supabase: set these in hosting environment settings, never in NEXT_PUBLIC_*.
# DATABASE_URL=postgresql://... (copy the Supabase transaction-pooler URI)
# DATABASE_CA_CERT=... (server root certificate PEM if needed for TLS verification)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=... (server-only legacy service_role key)
# SUPABASE_STORAGE_BUCKET=menu-photos

# Set the canonical HTTPS origin when hosting behind a reverse proxy.
# APP_ORIGIN=https://orders.example.com

# Extra development hosts, e.g. your ngrok hostname (no scheme or port).
# Comma-separated; update when your tunnel URL changes and restart npm run dev.
# DEV_ALLOWED_ORIGINS=your-tunnel.ngrok-free.app
